{
  "name": "my-crossy-road-game",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "npx next dev",
    "build": "npx next build",
    "start": "npx next start",
    "lint": "npx next lint",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev:clean": "npm run clean && npx next dev",
    "db:up": "docker compose up -d",
    "db:pgadmin": "docker compose -f docker-compose.pgadmin.yml up -d",
    "db:down": "docker compose down",
    "db:down:pgadmin": "docker compose -f docker-compose.pgadmin.yml down",
    "db:logs": "docker compose logs -f",
    "db:setup": "docker compose up -d && npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "db:ui": "npx prisma studio"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "next": "^14.2.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.176.0",
    "prisma": "^5.22.0",
    "typescript": "^5.5.3"
  }
}
