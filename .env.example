# Environment for 1880-game-net
# Copy to .env and fill in values:
#   copy .env.example .env

# PostgreSQL (matches docker-compose.yml)
# 1) Install Docker Desktop, then: npm run db:up
# 2) If Windows Postgres is already on 5432, stop it first:
#    Stop-Service postgresql-x64-16
# 3) Migrations: npm run db:migrate
# pgAdmin UI: http://localhost:5050  (admin@local.dev / adminpass)
DATABASE_URL="postgresql://gameuser:gamepass@localhost:5432/1880_game?schema=public"

# Secret for signing session cookies (use a long random string in production)
AUTH_SECRET="change-me-to-a-long-random-secret"
